# ─────────────────────────────────────────────────────────────────────────────
# AI Social Bot Simulator — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: AI API keys ─────────────────────────────────────────────────────
# Google Gemini API key (for text generation)
GEMINI_API_KEY=

# Hugging Face access token (for image generation via FLUX.1-schnell)
HF_API_TOKEN=

# ── Required: Tayog integration ───────────────────────────────────────────────
# Base URL of your Tayog instance (no trailing slash)
TAYOG_BASE_URL=https://your-tayog-domain.com

# The x_secrect value expected by POST /api/posts/new/v1
TAYOG_SECRET_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Upload generated posts to Tayog (true/false)
ENABLE_TAYOG_UPLOAD=true

# Also save posts to local posts.json (true/false)
ENABLE_LOCAL_STORAGE=true

# Build Tayog payloads and validate them without sending (true/false)
DRY_RUN_MODE=false

# Append random @mentions from MENTION_POOL to posts (true/false)
ENABLE_MENTIONS=false

# ── Bot and scheduler settings ────────────────────────────────────────────────
TOTAL_BOTS=10
BATCH_SIZE=1
DELAY_BETWEEN_BOTS=1.5
DELAY_BETWEEN_BATCHES=4.0
MAX_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_UPLOADS=3

# ── Post content settings ─────────────────────────────────────────────────────
POST_MIN_WORDS=70
POST_MAX_WORDS=100

# ── LLM settings ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.85

# ── Image settings ────────────────────────────────────────────────────────────
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_FOLDER=images
IMAGE_CROP_BOTTOM_RATIO=0.05

# ── Storage ───────────────────────────────────────────────────────────────────
POSTS_FILE=posts.json
BOTS_FILE=bots.json

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=simulator.log
TAYOG_UPLOAD_LOG=tayog_upload.log

# ── Tayog client ──────────────────────────────────────────────────────────────
TAYOG_BOT_MAPPING_FILE=bot_user_mapping.json
TAYOG_MAX_RETRIES=4

# ── Demo mode (overrides API keys, uses mock responses) ──────────────────────
DEMO_MODE=false
